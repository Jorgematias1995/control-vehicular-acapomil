# Copie este archivo como .streamlit/secrets.toml y complete sus datos.
# secrets.toml está en .gitignore: nunca se sube a GitHub.
# En Streamlit Cloud, pegue este mismo contenido en Settings > Secrets.

[supabase]
url = "https://TU-PROYECTO.supabase.co"
key = "sb_secret_..."          # Supabase > Settings > API Keys > Secret key

[app]
modo_demo = false              # true = elegir rol sin contraseña (solo pruebas locales)
